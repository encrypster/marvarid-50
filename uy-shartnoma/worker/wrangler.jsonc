{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uy-shartnoma-bot",
  "main": "src/entry.js",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "compatibility_date": "2026-11-01",
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "KV", "id": "7ab5ddb43deb434895ce96a144e795e1" }
  ],
  "vars": {
    "DAILY_LIMIT": "5",
    "MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": { "enabled": true }
  // Maxfiy qiymatlar (Cloudflare sahifasida Settings -> Variables and Secrets):
  //   TELEGRAM_BOT_TOKEN — majburiy
  //   ANTHROPIC_API_KEY  — boʻlsa tahlil Claude'da ishlaydi, boʻlmasa bepul Workers AI modelida
}
