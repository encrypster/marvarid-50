{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uy-shartnoma-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "KV", "id": "7ab5ddb43deb434895ce96a144e795e1" }
  ],
  "vars": {
    "DAILY_LIMIT": "3",
    "MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "observability": { "enabled": true }
  // TELEGRAM_BOT_TOKEN maxfiy qiymat: Cloudflare sahifasida Settings -> Variables and Secrets.
}
